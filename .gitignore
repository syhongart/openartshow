# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage

# Crashlytics generated file
crashlytics-build.properties

# Node — 로컬 개발/테스트 도구(vitest·eslint·tsc·playwright)만. 배포 "산출물"은
# 의존성 0(vendor 직서빙·자기완결)이라 런타임 번들엔 npm이 없다. 단 package.json·
# lock은 CI(테스트/린트/타입체크)의 재현성을 위해 커밋한다. node_modules만 무시.
node_modules/

# Jekyll CI 빌드 산출물 (deploy.yml 생성, 헤드리스 검증 하네스가 로컬 생성)
# _site_baseline 은 스모크 vite 모드의 동등성 대조용 web직조립본.
_site/
_site_baseline/

# 계약직 에이전트 격리 워크트리(임시, 자동 정리)
.claude/worktrees/

# Vite 검증기(B-2a) 빌드 산출물 — 커밋 제외(정적 배포는 deploy.yml 의 _site 조립이 담당)
/dist/

# 헤드리스 QA 하네스가 만드는 배포경로 모사 부산물(원본은 frontend/world/manifest.json,
# 실제 배포는 vite가 frontend/world → dist/app/world 로 복사). 반복 재생성되므로 무시.
/frontend/app/
.qa-tmp/
qa-tmp/

# 임시 검증 스크립트 — 게이트 중 반복 생성/삭제하는 일회성 하네스(prof·레이스·보행 재현 등).
# 프로젝트 루트에서 돌려야 node_modules(playwright)와 scripts/smoke/* 재사용이 되므로 여기 두되,
# 커밋 대상은 아니다. 정식 검증은 scripts/smoke/ 아래 하네스가 담당한다.
/__*.mjs

# 생성 산출물 — 소스는 docs/DEVLOG.md·ROSTER·valuation-history.json 이고, 아래는 전부
# scripts/build-*.mjs 가 만든다. CI(deploy.yml)가 vite build 앞에서 3종+making을 돌리므로
# 저장소에 커밋된 사본은 중복이었다.
#
# 빼는 이유는 소음이 아니라 경계다 — 생성물이 추적되면 개발일지를 한 줄 고칠 때마다
# 워킹트리에 산출물이 쌓이고, 그게 배포 게이트 중 "uncommitted" 경고로 누적돼 정작
# 봐야 할 변경을 가린다. 실제로 오늘 그 이유로 별도 커밋을 세 번 만들었다.
#
# 주의 ①: docs/valuation-history.json 은 산출물이 아니라 **상태**다(날짜별 이력, 같은 날
# 안에서는 멱등 upsert). 저장소에 남는다.
#
# 주의 ②: `/making/devlog/img/` 는 **추적 대상**이다 — 손으로 넣은 스크린샷 13장.
# 예전 `/devlog/img/` 규칙을 새 경로로 옮겨다. 통째로 지우면 자산이 날아간다.
# 규칙: 상위 디렉터리가 무시되면 하위의 예외가 안 먹으므로 모든 making/** 을 무시한 후
# devlog/img/ 경로만 복구한다.
#
# 주의 ③: `/devlog/*.html` 과 `/team/index.html` · `/valuation/index.html` 규칙.
# 스텁(리다이렉트) 페이지만 무시하려던 것이지만, devlog 의 산출물 141개가 옛 경로에
# 계속 들어와 untracked 로 노출되는 것을 방지하려고 devlog 는 전체 HTML 을 무시한다.
# (team·valuation 은 생성기가 아예 새 경로 making/ 에서만 생성하므로 스텁만 유지해도 된다.)
/making/**
!/making/devlog/
!/making/devlog/img/
!/making/devlog/img/**
/devlog/*.html
/team/index.html
/valuation/index.html
/sitemap.xml
/robots.txt

# 게이트 통과 스탬프 (scripts/gate.mjs → scripts/githooks/pre-commit)
/.gate-stamp

# 스모크 부산물 — 부팅 기준선 회차 기록(로컬 추이용).
# `docs/valuation-history.json` 이 커밋돼 있어 스모크를 돌 때마다 워킹트리를
# 더럽히고 매번 손으로 되돌리는 일이 반복됐다(태스크 #168). 같은 것을 또 만들지
# 않으려고 처음부터 무시한다 — CI 처럼 매번 새 러너인 곳에서는 직전 값이 없고,
# 그 경우 "첫 회차" 로 적힌다(변화 없음으로 적지 않는다).
/.smoke-baseline.jsonl
