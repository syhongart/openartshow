{
  "name": "openartshow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "브라우저 기반 3D 가상 미술관 — 정적 호스팅·자기완결. 자기완결 = 방문자 브라우저가 외부 호스트를 부르지 않는다는 뜻이지 라이브러리를 안 쓴다는 뜻이 아니다 — three·peerjs 는 npm 에서 받아 vendor/ 로 직서빙한다. 아래 devDependencies 는 개발·검증 도구다.",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:refs": "node scripts/smoke/check-refs.mjs",
    "check:gitadd": "node scripts/smoke/check-workflow-gitadd.mjs",
    "check:devlog-times": "node scripts/extract-devlog-times.mjs --check",
    "lint": "eslint .",
    "gate": "node scripts/gate.mjs",
    "smoke": "node scripts/smoke/run.mjs",
    "smoke:vite": "node scripts/smoke/run.mjs vite",
    "smoke:live": "node scripts/smoke/verify-live.mjs",
    "snapshot:styles": "node scripts/smoke/snapshot-styles.mjs",
    "measure:sky-warm": "node scripts/smoke/measure-sky-warm.mjs",
    "measure:invariants": "node scripts/smoke/measure-invariants.mjs",
    "measure:submerge": "node scripts/smoke/measure-submerge.mjs",
    "measure:water-mode": "node scripts/smoke/measure-water-mode.mjs",
    "measure:collide": "node scripts/smoke/measure-collide.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^9.18.0",
    "jsdom": "^29.1.1",
    "peerjs": "^1.5.4",
    "playwright": "^1.61.1",
    "puppeteer": "^25.3.0",
    "three": "^0.171.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
