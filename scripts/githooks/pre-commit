#!/bin/sh
# scripts/githooks/pre-commit — 게이트를 통과하지 않은 내용은 커밋되지 않는다.
#
# ── 왜 훅인가 (감독 지시 2026-07-30) ────────────────────────────────────────
# 게이트 실패를 **화면에서 보고도 커밋한 것**이 이 세션에서 두 번 있었다. 문서에
# "게이트를 확인하고 커밋한다" 고 적는 것으로는 안 막혔다 — 규율을 어겨도 아무 일이
# 일어나지 않기 때문이다. 그래서 실제로 막는다.
#
# 판정 방식: `npm run gate` 가 통과하면 그때의 **index 트리 해시**를 `.gate-stamp`
# 에 남긴다. 이 훅은 지금 커밋될 index 의 트리 해시를 다시 계산해 스탬프와 비교한다.
#   같으면  → 게이트를 통과한 바로 그 내용이다. 통과.
#   다르면  → 게이트 이후에 뭔가 바뀌었다(또는 아예 안 돌렸다). 차단.
#
# 트리 해시를 쓰는 이유: 커밋 메시지·시각·부모와 무관하게 **내용만** 가리킨다. 그래서
# amend·rebase 로 메시지만 바꿀 때 헛되게 막지 않는다.
#
# 우회: 정말 필요하면 `git commit --no-verify`. 그것을 막지는 않는다 — 훅으로 막을 수
# 있는 것은 실수이고, 의도한 우회는 사람의 판단이다. 다만 우회했으면 그 사실을 커밋
# 메시지나 보고에 적어라(안 적으면 "게이트를 통과했다" 가 거짓이 된다).

if [ "$SKIP_GATE_HOOK" = "1" ]; then
  echo "pre-commit: SKIP_GATE_HOOK=1 — 게이트 검사를 건너뛴다."
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
STAMP="$ROOT/.gate-stamp"

# 병합 커밋은 검사하지 않는다 — 내용이 두 부모의 결합이고, 충돌 해소 중에는 게이트를
# 돌릴 수 없는 중간 상태가 정상이다. 병합 후 게이트는 별도로 돈다(CI 의 verify job).
if [ -f "$ROOT/.git/MERGE_HEAD" ]; then
  exit 0
fi

CURRENT=$(git write-tree 2>/dev/null)
if [ -z "$CURRENT" ]; then
  echo "pre-commit: git write-tree 실패 — 검사를 건너뛴다(차단하지 않는다)."
  exit 0
fi

if [ ! -f "$STAMP" ]; then
  echo ""
  echo "✗ 커밋 중단 — 게이트를 돌린 기록이 없다."
  echo ""
  echo "    npm run gate"
  echo ""
  echo "  를 먼저 돌려라. 통과하면 스탬프가 생기고 이 커밋이 통과한다."
  echo "  (staged 상태를 검사하므로 'git add' 를 먼저 하고 게이트를 돌리는 것이 맞다)"
  echo ""
  exit 1
fi

STAMPED=$(cat "$STAMP" 2>/dev/null | tr -d '[:space:]')

if [ "$CURRENT" != "$STAMPED" ]; then
  echo ""
  echo "✗ 커밋 중단 — 게이트를 통과한 내용과 지금 커밋될 내용이 다르다."
  echo ""
  echo "    게이트 통과 시점: $STAMPED"
  echo "    지금 커밋될 내용: $CURRENT"
  echo ""
  echo "  게이트를 돌린 뒤에 파일이 바뀌었거나, staged 범위가 달라졌다."
  echo "  'git add' 를 마친 뒤 'npm run gate' 를 다시 돌려라."
  echo ""
  exit 1
fi

echo "pre-commit: 게이트 스탬프 일치 ($(echo "$CURRENT" | cut -c1-12)) — 통과."
exit 0
